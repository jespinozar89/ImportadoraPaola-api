generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Enums (Basados en tus ENUM de SQL) ---
enum Rol {
  cliente
  administrador
}

enum EstadoCategoria {
  Activo
  Inactivo
}

enum EstadoPedido {
  Pendiente
  PendienteDeConfirmacion
  EnPreparacion
  Despachado
  Listo
  Entregado
  Cancelado
  EnDevolucion
  ConExcepcion
}

enum TipoEntrega {
  retiro
  despacho
}

enum Courier {
  STARKEN
  CHILEXPRESS
  OTRO
}

enum EstadoEnvio {
  CREADO
  EN_TRANSITO_A_DESTINO
  RECIBIDO_EN_AGENCIA
  EN_REPARTO
  ENTREGADO
  NO_ENTREGADO
  DEVUELTO
  REDESTINADO
  CERRADO_CON_EXCEPCION
  PENDIENTE
  ANULADO
}

// --- Modelos ---

model Usuario {
  usuario_id         Int       @id @default(autoincrement())
  rut                Int?      @unique             
  dv                 String?   @db.VarChar(1)
  nombres            String    @db.VarChar(100)
  apellidos          String    @db.VarChar(100)
  telefono           String    @db.VarChar(20)
  email              String    @unique @db.VarChar(150)
  password_hash      String    @db.VarChar(255)
  rol                Rol       @default(cliente)
  fecha_registro     DateTime  @default(now()) @db.Timestamp(0)
  ultima_conexion    DateTime? @db.Timestamp(0)
  reset_token        String?   @unique
  reset_token_expiry DateTime?
  intentos_fallidos  Int       @default(0)
  bloqueado          Boolean   @default(false)
  bloqueado_hasta    DateTime?

  // Relaciones
  pedidos   Pedido[]
  favoritos Favorito[]
  carrito   Carrito[]
  direcciones DireccionUsuario[]

  @@map("Usuarios") 
}

model DireccionUsuario {
  direccion_id      Int     @id @default(autoincrement())
  usuario_id        Int
  calle             String  @db.VarChar(150)
  numero            String  @db.VarChar(20)
  departamento      String? @db.VarChar(50)
  comuna            String  @db.VarChar(100)
  region            String  @db.VarChar(100)
  es_predeterminada Boolean @default(false)

  // Relación con el usuario
  usuario Usuario @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)

  @@index([usuario_id])
  @@map("DireccionesUsuarios")
}

model Categoria {
  categoria_id Int             @id @default(autoincrement())
  nombre       String          @db.VarChar(100)
  descripcion  String?         @db.Text
  estado       EstadoCategoria @default(Activo)

  // Relaciones
  productoCategorias ProductoCategoria[]

  @@map("Categorias")
}

model ProductoCategoria {
  producto_id  Int
  categoria_id Int

  producto  Producto  @relation(fields: [producto_id], references: [producto_id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoria_id], references: [categoria_id], onDelete: Cascade)

  @@id([producto_id, categoria_id])
  @@map("ProductosCategorias")
}

model Producto {
  producto_id     Int      @id @default(autoincrement())
  producto_codigo String   @unique @db.VarChar(250)
  nombre          String   @db.VarChar(150)
  descripcion     String?  @db.Text
  precio          Decimal  @db.Decimal(10, 2)
  precio_oferta   Decimal? @db.Decimal(10, 2)
  stock           Int      @default(0)

  // Relaciones
  productoCategorias ProductoCategoria[] 
  detalles           ProductoPedido[]
  favoritos          Favorito[]
  carrito            Carrito[]
  imagenes           ProductoImagen[]

  @@map("Productos")
}

model ProductoImagen {
  imagen_id    Int     @id @default(autoincrement())
  url          String  @db.MediumText
  es_principal Boolean @default(false)
  orden        Int     @default(0)

  producto_id Int
  producto    Producto @relation(fields: [producto_id], references: [producto_id], onDelete: Cascade)

  @@index([producto_id])
}

model Pedido {
  pedido_id           Int          @id @default(autoincrement())
  klap_order_id       String?      @db.VarChar(64)
  usuario_id          Int?
  fecha_pedido        DateTime     @default(now()) @db.Timestamp(0)
  fecha_cambio_estado DateTime?
  estado              EstadoPedido @default(Pendiente)
 
 // Nombramiento explícito de los montos
  subtotal            Decimal      @default(0) @db.Decimal(10, 2)
  costo_envio         Decimal      @default(0) @db.Decimal(10, 2)
  total               Decimal      @default(0) @db.Decimal(10, 2)

  // Información del tipo de envío
  tipo_entrega        TipoEntrega  @default(retiro)

  // Datos de usuario y Invitado
  nombre_contacto     String       @db.VarChar(150)
  email_contacto      String       @db.VarChar(150)
  telefono_contacto   String       @db.VarChar(50)
  direccion_envio     String       @db.Text

  // Relaciones
  usuario  Usuario?         @relation(fields: [usuario_id], references: [usuario_id])
  detalles ProductoPedido[]
  envio    Envio?

  @@map("Pedidos")
}

model ProductoPedido {
  pedido_id              Int
  producto_id            Int
  cantidad               Int
  precio_unitario        Decimal  @db.Decimal(10, 2)
  precio_unitario_oferta Decimal? @db.Decimal(10, 2)

  // Relaciones
  pedido   Pedido   @relation(fields: [pedido_id], references: [pedido_id], onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [producto_id])

  @@id([pedido_id, producto_id])
  @@map("ProductosPedido")
}

model Favorito {
  favorito_id    Int      @id @default(autoincrement())
  usuario_id     Int
  producto_id    Int
  fecha_agregado DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [producto_id], onDelete: Cascade)

  @@unique([usuario_id, producto_id])
}

model Carrito {
  carrito_id     Int      @id @default(autoincrement())
  usuario_id     Int
  producto_id    Int
  cantidad       Int      @default(1)
  fecha_agregado DateTime @default(now())

  usuario  Usuario  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [producto_id], onDelete: Cascade)

  @@unique([usuario_id, producto_id])
}

model Envio {
  envio_id           Int         @id @default(autoincrement())
  pedido_id          Int         @unique
  courier            Courier     @default(STARKEN)
  numero_flete       String      @unique @db.VarChar(50)
  numero_flete_nuevo String?     @db.VarChar(50)
  estado             EstadoEnvio @default(CREADO)

  fecha_despacho  DateTime? @db.Timestamp(0)
  fecha_entrega   DateTime? @db.Timestamp(0)
  rut_recibe      String?   @db.VarChar(20)
  nombre_recibe   String?   @db.VarChar(150)
  latitud         String?   @db.VarChar(50)
  longitud        String?   @db.VarChar(50)
  url_comprobante String?   @db.Text

  tipo_devolucion String? @db.VarChar(150)
  observacion     String? @db.Text

  creado_en      DateTime @default(now()) @db.Timestamp(0)
  actualizado_en DateTime @updatedAt @db.Timestamp(0)

  pedido    Pedido           @relation(fields: [pedido_id], references: [pedido_id], onDelete: Cascade)
  historial HistorialEnvio[]

  @@map("Envios")
}

model HistorialEnvio {
  historial_id       Int      @id @default(autoincrement())
  envio_id           Int
  estado_macro       String   @db.VarChar(100)
  estado_micro       Int?
  descripcion_estado String?  @db.Text
  fecha_evento       DateTime @db.Timestamp(0)
  raw_payload        Json?

  creado_en DateTime @default(now()) @db.Timestamp(0)

  envio Envio @relation(fields: [envio_id], references: [envio_id], onDelete: Cascade)

  @@index([envio_id])
  @@map("HistorialesEnvios")
}
